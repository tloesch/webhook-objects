# GitHub personal access token for the account whose review requests to display.
# For a classic PAT: scope "repo" for private repositories; authorize org SSO if needed.
GH_TOKEN=

# GitHub PR search filter (GitHub search syntax).
GH_PR_FILTER="review-requested:@me state:open"

# URL and signing secret of your Gather Smart Object (preset: inbox).
GATHER_WEBHOOK_URL=
GATHER_WEBHOOK_SECRET=

# Poll interval in seconds (positive integer).
POLL_INTERVAL_SECONDS=60
